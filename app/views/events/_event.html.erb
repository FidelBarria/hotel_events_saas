<% booking = event.bookings.first %><article id="<%= dom_id event %>" class="card content-card h-100"><div class="card-body d-flex flex-column"><div class="page-eyebrow">Evento · <%= booking&.status&.humanize || "Programação pendente" %></div><h2 class="h5 fw-bold mt-2"><%= link_to event.title, event, class: "link-dark text-decoration-none" %></h2><p class="text-secondary small"><%= event.client&.name.presence || event.client&.email || "Cliente não informado" %></p><div class="small flex-grow-1"><span class="fw-semibold"><%= event.attendee_count %> pessoas</span><span class="text-secondary"> · <%= Event::SETUP_FORMATS[event.setup_format] %></span></div><% if booking %><div class="small mt-2"><span class="fw-semibold"><%= event.bookings.map { |item| item.room&.name }.compact.uniq.join(", ") %></span><span class="text-secondary"> · <%= l(booking.start_time, format: :short) %></span></div><% end %><div class="small text-secondary border-top pt-3 mt-3">Solicitado por <%= event.requester_name %></div></div></article>
