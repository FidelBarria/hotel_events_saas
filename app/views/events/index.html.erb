<% content_for :title, "Eventos" %>
<main class="page-container">
  <div class="page-heading d-flex flex-column flex-sm-row align-items-sm-end justify-content-between gap-3"><div><div class="page-eyebrow">Programação</div><h1 class="h2 fw-bold mt-2 mb-1">Eventos</h1><p class="text-secondary mb-0">Organize os eventos que você está planejando.</p></div><%= link_to "＋ Novo evento", new_event_path, class: "btn btn-primary" %></div>
  <% if @events.any? %><div class="row g-4"><% @events.each do |event| %><div class="col-md-6 col-xl-4"><div class="d-flex flex-column h-100"><%= render event %><div class="d-flex gap-2 mt-2"><%= link_to "Ver detalhes", event, class: "btn btn-outline-primary btn-sm flex-grow-1" %><%= link_to "Editar", edit_event_path(event), class: "btn btn-outline-secondary btn-sm" %></div></div></div><% end %></div>
  <% else %><section class="card empty-state text-center"><div class="card-body py-5 px-3"><div class="display-5 text-primary mb-3" aria-hidden="true">▦</div><h2 class="h5 fw-bold">Nenhum evento cadastrado</h2><p class="text-secondary">Crie seu primeiro evento para começar a organizar as reservas.</p><%= link_to "Criar primeiro evento", new_event_path, class: "btn btn-primary mt-2" %></div></section><% end %>
</main>
