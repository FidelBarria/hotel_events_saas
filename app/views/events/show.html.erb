<% content_for :title, @event.title %>
<main class="page-container" style="max-width: 1280px" data-controller="event-services" data-next-room-index="<%= @additional_bookings.length %>">
  <nav aria-label="breadcrumb" class="mb-3 no-print"><ol class="breadcrumb"><li class="breadcrumb-item"><%= link_to "Eventos", events_path %></li><li class="breadcrumb-item active"><%= @event.title %></li></ol></nav>
  <section class="card hero-panel no-print"><div class="card-body p-4"><span class="badge text-bg-light text-primary">Evento</span><h1 class="display-6 fw-bold mt-3"><%= @event.title %></h1><p class="text-white-50 mb-0"><%= @event.description.presence || "Sem observações adicionais." %></p></div></section>
  <section class="card content-card mt-4 no-print"><div class="card-body p-4"><div class="page-eyebrow">Solicitação</div><h2 class="h5 fw-bold mt-2 mb-3">Dados principais</h2><div class="row g-3">
    <div class="col-md-6"><div class="small text-secondary">Cliente</div><div class="fw-semibold"><%= @event.client&.name.presence || @event.client&.email || "Cliente não informado" %></div></div>
    <div class="col-md-6"><div class="small text-secondary">Solicitado por</div><div class="fw-semibold"><%= @event.requester_name %></div><div class="small text-secondary"><%= @event.requester_phone %> · <%= @event.requester_email %></div></div>
    <div class="col-md-4"><div class="small text-secondary">Participantes</div><div class="fw-semibold"><%= @event.attendee_count %> pessoas</div></div><div class="col-md-4"><div class="small text-secondary">Montagem</div><div class="fw-semibold"><%= Event::SETUP_FORMATS[@event.setup_format] %></div></div><div class="col-md-4"><div class="small text-secondary">Criado por</div><div class="fw-semibold"><%= @event.user.name.presence || @event.user.email %></div></div>
  </div></div></section>

  <section class="card content-card mt-3 no-print"><div class="card-header bg-white p-4"><div class="page-eyebrow">Programação</div><h2 class="h5 fw-bold mt-2 mb-1">Salas, horários e serviços</h2><p class="text-secondary mb-0">Adicione todas as salas usadas pelo evento. Cada serviço pode ser repetido e associado à sala correspondente.</p></div><div class="card-body p-4">
    <% if @event.errors.any? || @booking_entries.any? { |_key, booking| booking.errors.any? } %><div class="alert alert-danger"><ul class="mb-0"><% (@event.errors.full_messages + @booking_entries.flat_map { |_key, booking| booking.errors.full_messages }).uniq.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>
    <%= form_with url: schedule_event_path(@event), method: :patch, scope: :event do %>
      <div class="d-flex justify-content-between align-items-center mb-3"><h3 class="h5 fw-bold mb-0">Salas do evento</h3><button type="button" class="btn btn-outline-primary btn-sm" data-action="event-services#addRoom">Adicionar sala</button></div>
      <div class="d-flex flex-column gap-3" data-event-services-target="roomList">
        <% @booking_entries.each do |key, booking| %>
          <% prefix = key == "primary" ? "event[booking_attributes]" : "event[additional_bookings_attributes][#{key}]" %>
          <% if booking.marked_for_destruction? %>
            <%= hidden_field_tag "#{prefix}[id]", booking.id %><%= hidden_field_tag "#{prefix}[_destroy]", "1" %>
          <% else %>
          <section class="border rounded-3 p-3" data-room-entry data-booking-key="<%= key %>">
            <%= hidden_field_tag "#{prefix}[id]", booking.id if booking.persisted? %>
            <%= hidden_field_tag "#{prefix}[_destroy]", "0", data: { room_destroy_field: true } if key != "primary" %>
            <div class="d-flex justify-content-between align-items-center mb-3"><h4 class="h6 fw-bold mb-0" data-room-heading><%= key == "primary" ? "Sala principal" : "Sala adicional" %></h4><% if key != "primary" %><button type="button" class="btn btn-sm btn-outline-danger" data-action="event-services#removeRoom">Remover sala</button><% end %></div>
            <div class="row g-3">
              <div class="col-md-6"><%= label_tag "#{prefix}[room_id]", "Sala", class: "form-label" %><%= select_tag "#{prefix}[room_id]", options_for_select(@eligible_rooms.map { |room| ["#{room.name} · #{room.capacity_for(@event.setup_format)} lugares", room.id, { "data-room-name" => room.name, "data-hourly-rate" => room.hourly_rate || 0, "data-daily-rate" => room.daily_rate || 0 }] }, booking.room_id), prompt: "Selecione uma sala", required: true, class: "form-select", data: { room_select: true, action: "change->event-services#recalculate" } %></div>
              <div class="col-md-6"><%= label_tag "#{prefix}[room_rate_type]", "Cobrança", class: "form-label" %><%= select_tag "#{prefix}[room_rate_type]", options_for_select(Booking::ROOM_RATE_TYPES.map { |value, label| [label, value] }, booking.room_rate_type || "hourly"), class: "form-select", data: { room_rate_type: true, action: "change->event-services#recalculate" } %></div>
              <div class="col-md-6"><%= label_tag "#{prefix}[start_date]", "Data inicial da reserva", class: "form-label" %><%= date_field_tag "#{prefix}[start_date]", booking.start_time&.to_date, required: true, class: "form-control", data: { room_start: true, action: "change->event-services#recalculate" } %></div>
              <div class="col-md-6"><%= label_tag "#{prefix}[end_date]", "Data final da reserva", class: "form-label" %><%= date_field_tag "#{prefix}[end_date]", booking.end_time&.to_date, required: true, class: "form-control", data: { room_end: true, action: "change->event-services#recalculate" } %></div>
              <div class="col-md-6"><%= label_tag "#{prefix}[status]", "Status", class: "form-label" %><%= select_tag "#{prefix}[status]", options_for_select(Booking::STATUSES.map { |status| [status.humanize, status] }, booking.status || "pendente"), class: "form-select" %></div>
              <div class="col-md-6 d-flex align-items-end"><div class="fw-semibold" data-room-total><%= number_to_currency(booking.room_total, unit: "R$ ", separator: ",", delimiter: ".") %></div></div>
            </div>
            <div class="mt-3 border-top pt-3"><div class="d-flex justify-content-between align-items-center mb-2"><div><h5 class="h6 fw-semibold mb-0">Dias e horários do evento</h5><div class="small text-secondary">Informe o dia e os horários de início e término do evento em cada uso da sala.</div></div><button type="button" class="btn btn-outline-secondary btn-sm" data-action="event-services#addUsage">Adicionar dia</button></div><div class="d-flex flex-column gap-2" data-usage-list>
              <% @room_usages.select { |usage| usage[:booking_key] == key }.each do |usage| %><div class="row g-2 align-items-end" data-usage-row><%= hidden_field_tag "event[room_usages][#{usage[:key]}][booking_key]", key %><div class="col-md-4"><label class="form-label">Data do evento</label><%= date_field_tag "event[room_usages][#{usage[:key]}][service_date]", usage[:service_date], class: "form-control", required: true, data: { action: "change->event-services#recalculate" } %></div><div class="col-md-3"><label class="form-label">Início do evento</label><%= time_field_tag "event[room_usages][#{usage[:key]}][start_time]", usage[:start_time], class: "form-control", required: true, data: { action: "change->event-services#recalculate" } %></div><div class="col-md-3"><label class="form-label">Término do evento</label><%= time_field_tag "event[room_usages][#{usage[:key]}][end_time]", usage[:end_time], class: "form-control", required: true, data: { action: "change->event-services#recalculate" } %></div><div class="col-md-2"><button type="button" class="btn btn-outline-danger w-100" data-action="event-services#removeUsage">Remover</button></div></div><% end %>
            </div></div>
          </section>
          <% end %>
        <% end %>
      </div>
      <template data-event-services-target="roomTemplate"><section class="border rounded-3 p-3" data-room-entry data-booking-key="NEW_ROOM">
        <input type="hidden" name="event[additional_bookings_attributes][NEW_ROOM][_destroy]" value="0" data-room-destroy-field>
        <div class="d-flex justify-content-between align-items-center mb-3"><h4 class="h6 fw-bold mb-0" data-room-heading>Nova sala</h4><button type="button" class="btn btn-sm btn-outline-danger" data-action="event-services#removeRoom">Remover sala</button></div><div class="row g-3">
        <div class="col-md-6"><label class="form-label" for="new_room_select_NEW_ROOM">Sala</label><select id="new_room_select_NEW_ROOM" name="event[additional_bookings_attributes][NEW_ROOM][room_id]" class="form-select" required data-room-select data-action="change->event-services#recalculate"><option value="">Selecione uma sala</option><% @eligible_rooms.each do |room| %><option value="<%= room.id %>" data-room-name="<%= room.name %>" data-hourly-rate="<%= room.hourly_rate || 0 %>" data-daily-rate="<%= room.daily_rate || 0 %>"><%= room.name %> · <%= room.capacity_for(@event.setup_format) %> lugares</option><% end %></select></div>
        <div class="col-md-6"><label class="form-label" for="new_room_rate_type_NEW_ROOM">Cobrança</label><select id="new_room_rate_type_NEW_ROOM" name="event[additional_bookings_attributes][NEW_ROOM][room_rate_type]" class="form-select" data-room-rate-type data-action="change->event-services#recalculate"><option value="hourly">Por hora</option><option value="daily">Diária</option></select></div>
        <div class="col-md-6"><label class="form-label" for="new_room_start_NEW_ROOM">Data inicial da reserva</label><input id="new_room_start_NEW_ROOM" name="event[additional_bookings_attributes][NEW_ROOM][start_date]" type="date" required class="form-control" data-room-start data-action="change->event-services#recalculate"></div>
        <div class="col-md-6"><label class="form-label" for="new_room_end_NEW_ROOM">Data final da reserva</label><input id="new_room_end_NEW_ROOM" name="event[additional_bookings_attributes][NEW_ROOM][end_date]" type="date" required class="form-control" data-room-end data-action="change->event-services#recalculate"></div>
        <div class="col-md-6"><label class="form-label" for="new_room_status_NEW_ROOM">Status</label><select id="new_room_status_NEW_ROOM" name="event[additional_bookings_attributes][NEW_ROOM][status]" class="form-select"><% Booking::STATUSES.each do |status| %><option value="<%= status %>"><%= status.humanize %></option><% end %></select></div><div class="col-md-6 d-flex align-items-end"><div class="fw-semibold" data-room-total>R$ 0,00</div></div></div><div class="mt-3 border-top pt-3"><div class="d-flex justify-content-between align-items-center mb-2"><div><h5 class="h6 fw-semibold mb-0">Dias de utilização</h5><div class="small text-secondary">Informe cada data em que a sala será utilizada.</div></div><button type="button" class="btn btn-outline-secondary btn-sm" data-action="event-services#addUsage">Adicionar data</button></div><div class="d-flex flex-column gap-2" data-usage-list></div></div></section></template>

      <template data-event-services-target="usageTemplate"><div class="row g-2 align-items-end" data-usage-row><input type="hidden" name="event[room_usages][USAGE_KEY][booking_key]" value="ROOM_KEY"><div class="col-md-4"><label class="form-label">Data do evento</label><input type="date" name="event[room_usages][USAGE_KEY][service_date]" class="form-control" required data-usage-date data-action="change->event-services#recalculate"></div><div class="col-md-3"><label class="form-label">Início do evento</label><input type="time" name="event[room_usages][USAGE_KEY][start_time]" class="form-control" required data-action="change->event-services#recalculate"></div><div class="col-md-3"><label class="form-label">Término do evento</label><input type="time" name="event[room_usages][USAGE_KEY][end_time]" class="form-control" required data-action="change->event-services#recalculate"></div><div class="col-md-2"><button type="button" class="btn btn-outline-danger w-100" data-action="event-services#removeUsage">Remover</button></div></div></template>

      <hr class="my-4"><div class="d-flex justify-content-between align-items-center mb-3"><div><h3 class="h5 fw-bold mb-1">Serviços da proposta</h3><p class="small text-secondary mb-0">Adicione o mesmo serviço mais de uma vez para informar horários diferentes.</p></div></div>
      <ul class="nav nav-tabs mb-3" role="tablist"><li class="nav-item" role="presentation"><button class="nav-link active" id="proposal-food-tab" data-bs-toggle="tab" data-bs-target="#proposal-food" type="button" role="tab">A&amp;B</button></li><li class="nav-item" role="presentation"><button class="nav-link" id="proposal-equipment-tab" data-bs-toggle="tab" data-bs-target="#proposal-equipment" type="button" role="tab">Equipamentos</button></li></ul>
      <div class="tab-content border rounded-3 p-3 mb-3"><div class="tab-pane fade show active" id="proposal-food" role="tabpanel"><div class="input-group"><select class="form-select" data-service-picker="food_beverage"><option value="">Selecione um item de A&amp;B</option><% @services.select { |service| service.category == "food_beverage" }.each do |service| %><option value="<%= service.id %>"><%= service.name %> · <%= number_to_currency(service.price, unit: "R$ ", separator: ",", delimiter: ".") %></option><% end %></select><button type="button" class="btn btn-outline-primary" data-action="event-services#addService">Adicionar A&amp;B</button></div></div><div class="tab-pane fade" id="proposal-equipment" role="tabpanel"><div class="input-group"><select class="form-select" data-service-picker="equipment"><option value="">Selecione um equipamento</option><% @services.select { |service| service.category == "equipment" }.each do |service| %><option value="<%= service.id %>"><%= service.name %> · <%= number_to_currency(service.price, unit: "R$ ", separator: ",", delimiter: ".") %></option><% end %></select><button type="button" class="btn btn-outline-primary" data-action="event-services#addService">Adicionar equipamento</button></div></div></div>
      <div class="row g-3 mb-3">
        <section class="col-12"><div class="card border-success-subtle"><div class="card-header bg-success-subtle fw-semibold">A&amp;B</div><div class="card-body d-flex flex-column gap-2" data-event-services-target="foodServiceLines"><% @service_lines.select { |line| line[:service].category == "food_beverage" }.each do |line| %><%= render "service_line", line: line %><% end %></div></div></section>
        <section class="col-12"><div class="card border-primary-subtle"><div class="card-header bg-primary-subtle fw-semibold">Equipamentos</div><div class="card-body d-flex flex-column gap-2" data-event-services-target="equipmentServiceLines"><% @service_lines.select { |line| line[:service].category == "equipment" }.each do |line| %><%= render "service_line", line: line %><% end %></div></div></section>
      </div>
      <template data-event-services-target="serviceTemplate"><div class="border rounded-3 p-3" data-service-line data-line-key="SERVICE_INDEX"><div class="row g-3 align-items-end">
        <div class="col-lg-2"><label class="form-label" for="service_select_SERVICE_INDEX">Serviço</label><select id="service_select_SERVICE_INDEX" name="event[service_lines][SERVICE_INDEX][service_id]" class="form-select" required data-service-select data-action="change->event-services#serviceChanged"><option value="">Selecione</option><% @services.each do |service| %><option value="<%= service.id %>" data-price="<%= service.price %>" data-category="<%= service.category %>"><%= service.name %> · <%= service.category == "equipment" ? "Equipamento" : "A&B" %></option><% end %></select></div>
        <div class="col-lg-2"><label class="form-label">Sala de atendimento</label><select name="event[service_lines][SERVICE_INDEX][booking_key]" class="form-select" data-line-booking data-action="change->event-services#recalculate"><% @booking_entries.each do |booking_key, booking| %><option value="<%= booking_key %>"><%= booking.room&.name || "Sala a definir" %></option><% end %></select></div>
        <div class="col-6 col-lg-1"><label class="form-label" for="service_quantity_SERVICE_INDEX">Qtd.</label><input id="service_quantity_SERVICE_INDEX" name="event[service_lines][SERVICE_INDEX][quantity]" type="number" value="1" min="1" step="1" required class="form-control" data-line-quantity data-action="input->event-services#recalculate"></div>
        <div class="col-6 col-lg-2"><label class="form-label" for="service_date_SERVICE_INDEX">Dia</label><input id="service_date_SERVICE_INDEX" name="event[service_lines][SERVICE_INDEX][service_date]" type="date" required class="form-control" data-service-date data-action="change->event-services#recalculate"></div>
        <div class="col-6 col-lg-2"><label class="form-label" for="service_time_SERVICE_INDEX">Horário</label><input id="service_time_SERVICE_INDEX" name="event[service_lines][SERVICE_INDEX][service_time]" type="time" required class="form-control" data-action="change->event-services#recalculate"></div>
        <div class="col-6 col-lg-2"><div class="small text-secondary">Valor unitário</div><div class="text-nowrap" data-line-unit>R$ 0,00</div><div class="small fw-bold text-primary text-nowrap" data-line-total>R$ 0,00</div></div><div class="col-6 col-lg-1"><button type="button" class="btn btn-outline-danger btn-sm w-100" data-action="event-services#removeService">Remover</button></div>
      </div></div></template>
      <div class="mt-4"><h4 class="h6 fw-bold">Resumo dos valores</h4><div class="table-responsive"><table class="table table-sm"><tbody><tr><th>Salas</th><td class="text-end" data-event-services-target="roomTotal"><%= number_to_currency(@room_total, unit: "R$ ", separator: ",", delimiter: ".") %></td></tr><tr><th>A&amp;B</th><td class="text-end" data-event-services-target="foodTotal"><%= number_to_currency(@food_total, unit: "R$ ", separator: ",", delimiter: ".") %></td></tr><tr><th>Equipamentos</th><td class="text-end" data-event-services-target="equipmentTotal"><%= number_to_currency(@equipment_total, unit: "R$ ", separator: ",", delimiter: ".") %></td></tr><tr class="table-light fw-bold"><th>Total do evento</th><td class="text-end" data-event-services-target="proposalTotal"><%= number_to_currency(@proposal_total, unit: "R$ ", separator: ",", delimiter: ".") %></td></tr></tbody></table></div></div>
      <div class="d-flex justify-content-end gap-2 border-top pt-3 mt-4"><%= link_to "Voltar para eventos", events_path, class: "btn btn-outline-secondary" %><%= submit_tag "Salvar programação e proposta", class: "btn btn-primary" %></div>
    <% end %>
  </div></section>

  <section class="quote-document print-only"><header class="quote-header"><div class="quote-brand">Hotel Events</div><div class="quote-label">Orçamento do evento</div><h1><%= @event.title %></h1><p>Gerado em <%= Date.current.strftime("%d/%m/%Y") %></p></header>
    <section class="quote-details"><h2>Cliente e evento</h2><div class="quote-detail-grid"><div><strong>Cliente</strong><span><%= @event.client&.name || @event.client&.email %></span></div><div><strong>Solicitante</strong><span><%= @event.requester_name %></span></div><div><strong>Contato</strong><span><%= @event.requester_phone %> · <%= @event.requester_email %></span></div><div><strong>Participantes</strong><span><%= @event.attendee_count %></span></div><div><strong>Montagem</strong><span><%= Event::SETUP_FORMATS[@event.setup_format] %></span></div></div></section>
    <section class="quote-items"><h2>Salas reservadas</h2><table><thead><tr><th>Sala</th><th>Datas reservadas e horários do evento</th><th>Status</th><th>Cobrança</th><th class="numeric">Total</th></tr></thead><tbody data-quote-rooms><% @booking_entries.each do |_key, booking| %><% next if booking.marked_for_destruction? %><tr><td><%= booking.room&.name || "A definir" %></td><td><%= booking.start_time&.to_date&.strftime("%d/%m/%Y") %> – <%= booking.end_time&.to_date&.strftime("%d/%m/%Y") %><% booking.room_usages.order(:service_date).each do |usage| %><br><%= usage.service_date.strftime("%d/%m/%Y") %>: <%= usage.start_time.presence || "Horário a informar" %>–<%= usage.end_time.presence || "Horário a informar" %><% end %></td><td><%= booking.status&.humanize %></td><td><%= Booking::ROOM_RATE_TYPES[booking.room_rate_type] %></td><td class="numeric"><%= number_to_currency(booking.room_total, unit: "R$ ", separator: ",", delimiter: ".") %></td></tr><% end %></tbody></table></section>
    <% [["A&B", "food_beverage", "food"], ["Equipamentos", "equipment", "equipment"]].each do |title, category, key| %><section class="quote-items"><h2><%= title %></h2><table><thead><tr><th>Item</th><th>Sala</th><th>Dia</th><th>Horário</th><th class="numeric">Qtd.</th><th class="numeric">Unitário</th><th class="numeric">Total</th></tr></thead><tbody data-quote-services-<%= key %>><% @service_lines.select { |line| line[:service].category == category }.each do |line| %><tr><td><%= line[:service].name %></td><td><%= @booking_entries.find { |booking_key, _booking| booking_key == line[:booking_key] }&.last&.room&.name || "Sala a definir" %></td><td><%= line[:service_date].respond_to?(:strftime) ? line[:service_date].strftime("%d/%m/%Y") : line[:service_date] %></td><td><%= line[:service_time] %></td><td class="numeric"><%= line[:quantity] %></td><td class="numeric"><%= number_to_currency(line[:service].price, unit: "R$ ", separator: ",", delimiter: ".") %></td><td class="numeric"><%= number_to_currency(line[:service].price * line[:quantity], unit: "R$ ", separator: ",", delimiter: ".") %></td></tr><% end %></tbody></table></section><% end %>
    <section class="quote-summary"><h2>Resumo dos valores</h2><table><tbody><tr><th>Salas</th><td data-event-services-target="roomTotal"><%= number_to_currency(@room_total, unit: "R$ ", separator: ",", delimiter: ".") %></td></tr><tr><th>A&amp;B</th><td data-event-services-target="foodTotal"><%= number_to_currency(@food_total, unit: "R$ ", separator: ",", delimiter: ".") %></td></tr><tr><th>Equipamentos</th><td data-event-services-target="equipmentTotal"><%= number_to_currency(@equipment_total, unit: "R$ ", separator: ",", delimiter: ".") %></td></tr><tr class="quote-grand-total"><th>Total do evento</th><td data-event-services-target="proposalTotal"><%= number_to_currency(@proposal_total, unit: "R$ ", separator: ",", delimiter: ".") %></td></tr></tbody></table></section>
  </section>
  <div class="d-flex flex-wrap gap-2 mt-4 no-print"><%= button_to "Excluir evento", @event, method: :delete, data: { turbo_confirm: "Excluir este evento?" }, class: "btn btn-outline-danger" %><button type="button" class="btn btn-success ms-sm-auto" data-controller="print" data-action="click->print#page">Exportar orçamento em PDF</button></div>
</main>
