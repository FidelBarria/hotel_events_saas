<% content_for :title, "Novo evento" %>
<main class="page-container" style="max-width: 850px"><nav aria-label="breadcrumb" class="mb-3"><ol class="breadcrumb"><li class="breadcrumb-item"><%= link_to "Eventos", events_path %></li><li class="breadcrumb-item active" aria-current="page">Novo evento</li></ol></nav><section class="card content-card"><div class="card-header bg-white p-4"><div class="page-eyebrow">Etapa 1 · Solicitação</div><h1 class="h3 fw-bold mt-2 mb-1">Criar evento</h1><p class="text-secondary mb-0">Informe cliente, contato, quantidade e formato. Sala e serviços serão definidos na próxima etapa.</p></div><div class="card-body p-4"><% if @clients.empty? %><div class="alert alert-warning">Ainda não há clientes cadastrados. Cadastre uma conta de cliente antes de criar um evento.</div><% end %><%= render "form", event: @event %></div></section></main>
