<% line_key = line[:key] %>
<div class="border rounded-3 p-3" data-service-line data-line-key="<%= line_key %>">
  <div class="row g-3 align-items-end">
    <div class="col-lg-2"><%= label_tag "event_service_#{line_key}", "Serviço", class: "form-label" %><%= select_tag "event[service_lines][#{line_key}][service_id]", options_for_select(@services.map { |service| ["#{service.name} · #{service.category == 'equipment' ? 'Equipamento' : 'A&B'}", service.id, { "data-price" => service.price, "data-category" => service.category }] }, line[:service].id), required: true, class: "form-select", id: "event_service_#{line_key}", data: { service_select: true, action: "change->event-services#serviceChanged" } %></div>
    <div class="col-lg-2"><label class="form-label">Sala de atendimento</label><select name="event[service_lines][<%= line_key %>][booking_key]" class="form-select" data-line-booking data-action="change->event-services#recalculate"><% @booking_entries.each do |booking_key, booking| %><option value="<%= booking_key %>" <%= "selected" if booking_key == line[:booking_key] %>><%= booking.room&.name || "Sala a definir" %></option><% end %></select></div>
    <div class="col-6 col-lg-1"><%= label_tag "event_quantity_#{line_key}", "Qtd.", class: "form-label" %><%= number_field_tag "event[service_lines][#{line_key}][quantity]", line[:quantity], min: 1, step: 1, required: true, class: "form-control", id: "event_quantity_#{line_key}", data: { line_quantity: true, action: "input->event-services#recalculate" } %></div>
    <div class="col-6 col-lg-2"><%= label_tag "event_date_#{line_key}", "Dia", class: "form-label" %><%= date_field_tag "event[service_lines][#{line_key}][service_date]", line[:service_date], required: true, class: "form-control", id: "event_date_#{line_key}", data: { action: "change->event-services#recalculate" } %></div>
    <div class="col-6 col-lg-2"><%= label_tag "event_time_#{line_key}", "Horário", class: "form-label" %><%= time_field_tag "event[service_lines][#{line_key}][service_time]", line[:service_time], required: true, class: "form-control", id: "event_time_#{line_key}", data: { action: "change->event-services#recalculate" } %></div>
    <div class="col-6 col-lg-2"><div class="small text-secondary">Valor unitário</div><div class="text-nowrap" data-line-unit><%= number_to_currency(line[:service].price, unit: "R$ ", separator: ",", delimiter: ".") %></div><div class="small fw-bold text-primary text-nowrap" data-line-total><%= number_to_currency(line[:service].price * line[:quantity], unit: "R$ ", separator: ",", delimiter: ".") %></div></div>
    <div class="col-6 col-lg-1"><button type="button" class="btn btn-outline-danger btn-sm w-100" data-action="event-services#removeService">Remover</button></div>
  </div>
</div>
