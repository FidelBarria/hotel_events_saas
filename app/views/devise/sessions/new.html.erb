<main class="auth-wrap"><div class="w-100" style="max-width: 450px"><header class="text-center mb-4"><div class="auth-brand">Hotel Events SaaS</div><h1 class="h2 fw-bold mt-2">Acesse sua conta</h1><p class="text-secondary">Entre para gerenciar os espaços e eventos do hotel.</p></header><section class="card auth-card"><div class="card-body p-4 p-sm-5"><%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %><div class="mb-3"><%= f.label :email, "E-mail", class: "form-label" %><%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "seu@email.com", class: "form-control" %></div><div class="mb-3"><%= f.label :password, "Senha", class: "form-label" %><%= f.password_field :password, autocomplete: "current-password", placeholder: "Sua senha", class: "form-control" %></div><% if devise_mapping.rememberable? %><div class="form-check mb-4"><%= f.check_box :remember_me, class: "form-check-input" %><%= f.label :remember_me, "Manter conectado", class: "form-check-label" %></div><% end %><%= f.submit "Entrar", class: "btn btn-primary w-100" %><% end %></div></section><%= render "devise/shared/links" %></div></main>
