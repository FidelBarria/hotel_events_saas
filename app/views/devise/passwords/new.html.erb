<main class="auth-wrap"><div class="w-100" style="max-width: 450px"><header class="text-center mb-4"><div class="auth-brand">Hotel Events SaaS</div><h1 class="h2 fw-bold mt-2">Esqueceu sua senha?</h1><p class="text-secondary">Enviaremos as instruções para o seu e-mail.</p></header><section class="card auth-card"><div class="card-body p-4 p-sm-5"><%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %><%= render "devise/shared/error_messages", resource: resource %><div class="mb-4"><%= f.label :email, "E-mail", class: "form-label" %><%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "seu@email.com", class: "form-control" %></div><%= f.submit "Enviar instruções", class: "btn btn-primary w-100" %><% end %></div></section><%= render "devise/shared/links" %></div></main>
