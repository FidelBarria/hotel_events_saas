<main class="auth-wrap"><div class="w-100" style="max-width: 450px"><header class="text-center mb-4"><div class="auth-brand">Hotel Events SaaS</div><h1 class="h2 fw-bold mt-2">Redefinir senha</h1><p class="text-secondary">Crie uma nova senha segura para sua conta.</p></header><section class="card auth-card"><div class="card-body p-4 p-sm-5"><%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %><%= render "devise/shared/error_messages", resource: resource %><%= f.hidden_field :reset_password_token %><div class="mb-3"><%= f.label :password, "Nova senha", class: "form-label" %><% if @minimum_password_length %><div class="form-text mb-1">Mínimo de <%= @minimum_password_length %> caracteres</div><% end %><%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form-control" %></div><div class="mb-4"><%= f.label :password_confirmation, "Confirmar nova senha", class: "form-label" %><%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control" %></div><%= f.submit "Salvar nova senha", class: "btn btn-primary w-100" %><% end %></div></section><%= render "devise/shared/links" %></div></main>
