<main class="auth-wrap"><div class="w-100" style="max-width: 480px"><header class="text-center mb-4"><div class="auth-brand">Hotel Events SaaS</div><h1 class="h2 fw-bold mt-2">Criar conta</h1><p class="text-secondary">Cadastre-se para acessar a plataforma.</p></header><section class="card auth-card"><div class="card-body p-4 p-sm-5"><%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %><%= render "devise/shared/error_messages", resource: resource %><div class="mb-3"><%= f.label :name, "Nome completo", class: "form-label" %><%= f.text_field :name, autofocus: true, autocomplete: "name", placeholder: "Seu nome", class: "form-control" %></div><div class="mb-3"><%= f.label :email, "E-mail", class: "form-label" %><%= f.email_field :email, autocomplete: "email", placeholder: "seu@email.com", class: "form-control" %></div><div class="mb-3"><%= f.label :password, "Senha", class: "form-label" %><% if @minimum_password_length %><div class="form-text mb-1">Mínimo de <%= @minimum_password_length %> caracteres</div><% end %><%= f.password_field :password, autocomplete: "new-password", class: "form-control" %></div><div class="mb-4"><%= f.label :password_confirmation, "Confirmar senha", class: "form-label" %><%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control" %></div><%= f.submit "Criar conta", class: "btn btn-primary w-100" %><% end %></div></section><%= render "devise/shared/links" %></div></main>
