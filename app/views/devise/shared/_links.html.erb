<div class="d-flex flex-column align-items-center gap-2 mt-4 small"><% if controller_name != 'sessions' %><%= link_to "Já tem uma conta? Entrar", new_session_path(resource_name), class: "link-primary text-decoration-none" %><% end %><% if devise_mapping.registerable? && controller_name != 'registrations' %><%= link_to "Ainda não tem conta? Cadastre-se", new_registration_path(resource_name), class: "link-primary text-decoration-none" %><% end %><% if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %><%= link_to "Esqueceu sua senha?", new_password_path(resource_name), class: "link-secondary text-decoration-none" %><% end %><% if devise_mapping.confirmable? && controller_name != 'confirmations' %><%= link_to "Não recebeu as instruções de confirmação?", new_confirmation_path(resource_name), class: "link-secondary text-decoration-none" %><% end %><% if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %><%= link_to "Não recebeu as instruções de desbloqueio?", new_unlock_path(resource_name), class: "link-secondary text-decoration-none" %><% end %></div>
