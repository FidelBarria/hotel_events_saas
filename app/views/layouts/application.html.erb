<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= content_for(:title) || "Hotel Events SaaS" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Hotel Events SaaS">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <%= stylesheet_link_tag "bootstrap_custom", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="app-shell">
    <% if notice || alert %>
      <div class="flash-stack">
        <% if notice %>
          <div class="alert alert-success shadow-sm" role="status"><%= notice %></div>
        <% end %>
        <% if alert %>
          <div class="alert alert-danger shadow-sm" role="alert"><%= alert %></div>
        <% end %>
      </div>
    <% end %>

    <% if user_signed_in? %>
      <header class="navbar navbar-expand-lg app-navbar">
        <div class="container-fluid app-container">
          <%= link_to "Hotel Events", root_path, class: "navbar-brand fw-bold" %>
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="Abrir navegação"><span class="navbar-toggler-icon"></span></button>
          <div class="collapse navbar-collapse" id="mainNavigation">
            <nav class="navbar-nav me-auto mb-2 mb-lg-0" aria-label="Navegação principal">
              <%= link_to "Visão geral", root_path, class: "nav-link #{current_page?(root_path) ? 'active' : ''}" %>
              <%= link_to "Espaços", rooms_path, class: "nav-link #{current_page?(rooms_path) ? 'active' : ''}" %>
              <%= link_to "Eventos", events_path, class: "nav-link #{current_page?(events_path) ? 'active' : ''}" %>
              <%= link_to "Clientes", clients_path, class: "nav-link #{current_page?(clients_path) ? 'active' : ''}" %>
              <%= link_to "A&B", services_path(category: "food_beverage"), class: "nav-link #{params[:category] == 'food_beverage' ? 'active' : ''}" %>
              <%= link_to "Equipamentos", services_path(category: "equipment"), class: "nav-link #{params[:category] == 'equipment' ? 'active' : ''}" %>
              <% if current_user.admin? %><%= link_to "Configurações", admin_users_path, class: "nav-link #{current_page?(admin_users_path) ? 'active' : ''}" %><% end %>
            </nav>
            <div class="d-flex align-items-center gap-3">
              <div class="text-end d-none d-sm-block"><div class="fw-semibold small"><%= current_user.name.presence || current_user.email %></div><div class="text-secondary small"><%= current_user.role.humanize %></div></div>
              <%= link_to "Perfil", edit_user_registration_path, class: "btn btn-outline-secondary btn-sm" %>
              <%= button_to "Sair", destroy_user_session_path, method: :delete, class: "btn btn-outline-danger btn-sm" %>
            </div>
          </div>
        </div>
      </header>
    <% end %>

    <%= yield %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
  </body>
</html>
