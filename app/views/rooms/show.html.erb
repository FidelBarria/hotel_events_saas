<main class="page-container"><nav aria-label="breadcrumb" class="mb-3"><ol class="breadcrumb"><li class="breadcrumb-item"><%= link_to "Espaços", rooms_path %></li><li class="breadcrumb-item active" aria-current="page"><%= @room.name %></li></ol></nav>
  <section class="card hero-panel"><div class="card-body p-4 p-lg-5"><span class="badge text-bg-light text-primary">Espaço para eventos</span><div class="d-flex flex-column flex-md-row align-items-md-end justify-content-between gap-3 mt-3"><div><h1 class="display-6 fw-bold"><%= @room.name %></h1><p class="mb-0 text-white-50"><%= @room.description.presence || "Ambiente disponível para receber eventos e encontros." %></p></div><% if user_signed_in? %><%= link_to "Editar espaço", edit_room_path(@room), class: "btn btn-light" %><% end %></div></div></section>
  <section class="row g-3 mt-1">
    <div class="col-md-6"><div class="card stat-card h-100"><div class="card-body p-4"><div class="text-secondary">Capacidade geral</div><div class="stat-value mt-2"><%= @room.capacity %> <span class="fs-6 fw-normal text-secondary">pessoas</span></div></div></div></div>
    <div class="col-md-6"><div class="card stat-card h-100"><div class="card-body p-4"><div class="text-secondary">Valor por hora</div><% if @room.hourly_rate.present? %><div class="stat-value mt-2">R$ <%= number_with_precision(@room.hourly_rate, precision: 2, delimiter: ".", separator: ",") %></div><% else %><div class="h5 text-secondary mt-3">Não informado</div><% end %></div></div></div>
    <div class="col-md-6"><div class="card stat-card h-100"><div class="card-body p-4"><div class="text-secondary">Valor por diária</div><% if @room.daily_rate.present? %><div class="stat-value mt-2">R$ <%= number_with_precision(@room.daily_rate, precision: 2, delimiter: ".", separator: ",") %></div><% else %><div class="h5 text-secondary mt-3">Não informado</div><% end %></div></div></div>
    <div class="col-12"><section class="card content-card"><div class="card-body p-4"><h2 class="h5 fw-bold mb-3">Capacidade por formato</h2><div class="row g-3"><% [["Auditório", @room.capacity_auditorium], ["Formato U", @room.capacity_u_shape], ["Escolar", @room.capacity_classroom], ["Mesas redondas", @room.capacity_round_tables]].each do |label, capacity| %><div class="col-sm-6 col-lg-3"><div class="rounded-3 bg-light p-3"><div class="small text-secondary"><%= label %></div><div class="h4 fw-bold mb-0 mt-1"><%= capacity.nil? ? "Não informado" : "#{capacity} pessoas" %></div></div></div><% end %></div></div></section></div>
  </section>
  <div class="mt-4"><%= link_to "← Voltar para espaços", rooms_path, class: "link-secondary text-decoration-none" %></div>
</main>
