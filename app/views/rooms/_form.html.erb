<%= form_with(model: room) do |f| %>
  <% if room.errors.any? %><div class="alert alert-danger"><h2 class="h6"><%= pluralize(room.errors.count, "erro") %> impediram salvar este espaço:</h2><ul class="mb-0"><% room.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>
  <div class="mb-3"><%= f.label :name, "Nome do espaço", class: "form-label" %><%= f.text_field :name, required: true, placeholder: "Ex.: Salão Principal", class: "form-control" %></div>
  <div class="mb-2"><%= f.label :capacity, "Capacidade geral (pessoas)", class: "form-label" %><%= f.number_field :capacity, min: 1, required: true, placeholder: "100", class: "form-control" %><div class="form-text">Informe também a capacidade específica de cada montagem, se souber.</div></div>
  <fieldset class="border rounded-3 p-3 mb-3"><legend class="float-none w-auto px-2 fs-6 fw-semibold">Capacidade por formato</legend><div class="row g-3"><div class="col-sm-6"><%= f.label :capacity_auditorium, "Auditório", class: "form-label" %><%= f.number_field :capacity_auditorium, min: 0, placeholder: "Não informado", class: "form-control" %></div><div class="col-sm-6"><%= f.label :capacity_u_shape, "Formato U", class: "form-label" %><%= f.number_field :capacity_u_shape, min: 0, placeholder: "Não informado", class: "form-control" %></div><div class="col-sm-6"><%= f.label :capacity_classroom, "Escolar", class: "form-label" %><%= f.number_field :capacity_classroom, min: 0, placeholder: "Não informado", class: "form-control" %></div><div class="col-sm-6"><%= f.label :capacity_round_tables, "Mesas redondas", class: "form-label" %><%= f.number_field :capacity_round_tables, min: 0, placeholder: "Não informado", class: "form-control" %></div></div></fieldset>
  <div class="row g-3 mb-3"><div class="col-md-6"><%= f.label :hourly_rate, "Valor por hora (R$)", class: "form-label" %><%= f.number_field :hourly_rate, min: 0, step: 0.01, placeholder: "500,00", class: "form-control" %></div><div class="col-md-6"><%= f.label :daily_rate, "Valor por diária (R$)", class: "form-label" %><%= f.number_field :daily_rate, min: 0, step: 0.01, placeholder: "3.000,00", class: "form-control" %></div></div>
  <div class="mb-4"><%= f.label :description, "Descrição", class: "form-label" %><%= f.text_area :description, rows: 4, placeholder: "Detalhe as características, equipamentos e diferenciais do espaço...", class: "form-control" %></div>
  <div class="d-flex flex-column-reverse flex-sm-row justify-content-end gap-2 border-top pt-3"><%= link_to "Cancelar", rooms_path, class: "btn btn-outline-secondary" %><%= f.submit(room.new_record? ? "Criar espaço" : "Salvar alterações", class: "btn btn-primary") %></div>
<% end %>
