<article id="<%= dom_id room %>" class="card content-card mb-3"><div class="card-body"><h2 class="h5 card-title"><%= room.name %></h2><p class="mb-1"><strong>Capacidade geral:</strong> <%= room.capacity %> pessoas</p><p class="mb-1"><strong>Auditório:</strong> <%= room.capacity_auditorium || "Não informado" %></p><p class="mb-1"><strong>Formato U:</strong> <%= room.capacity_u_shape || "Não informado" %></p><p class="mb-1"><strong>Escolar:</strong> <%= room.capacity_classroom || "Não informado" %></p><p class="mb-1"><strong>Mesas redondas:</strong> <%= room.capacity_round_tables || "Não informado" %></p><p class="mb-1"><strong>Valor por hora:</strong> <%= room.hourly_rate.present? ? number_to_currency(room.hourly_rate, unit: "R$ ", separator: ",", delimiter: ".") : "Não informado" %></p><p class="mb-1"><strong>Valor por diária:</strong> <%= room.daily_rate.present? ? number_to_currency(room.daily_rate, unit: "R$ ", separator: ",", delimiter: ".") : "Não informado" %></p><p class="card-text text-secondary mb-0"><%= room.description %></p></div></article>
