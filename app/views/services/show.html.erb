<% content_for :title, @service.name %>
<main class="page-container" style="max-width: 900px"><nav aria-label="breadcrumb" class="mb-3"><ol class="breadcrumb"><li class="breadcrumb-item"><%= link_to "A&B e equipamentos", services_path(category: @service.category) %></li><li class="breadcrumb-item active" aria-current="page"><%= @service.name %></li></ol></nav><section class="card hero-panel"><div class="card-body p-4 p-lg-5"><span class="badge text-bg-light text-primary"><%= Service::TYPE_LABELS[@service.service_type] %></span><h1 class="display-6 fw-bold mt-3"><%= @service.name %></h1><p class="h3 mb-0"><%= number_to_currency(@service.price, unit: "R$ ", separator: ",", delimiter: ".") %> <span class="fs-6 text-white-50">por unidade</span></p></div></section><div class="d-flex gap-2 mt-4"><%= link_to "Editar item", edit_service_path(@service), class: "btn btn-primary" %><%= link_to "Voltar ao catálogo", services_path(category: @service.category), class: "btn btn-outline-secondary" %></div></main>
