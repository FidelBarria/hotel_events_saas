<% category_label = { "food_beverage" => "Alimentos e bebidas", "equipment" => "Equipamentos" }[@category] %>
<% content_for :title, category_label || "Serviços e extras" %>
<main class="page-container">
  <div class="page-heading d-flex flex-column flex-sm-row align-items-sm-end justify-content-between gap-3"><div><div class="page-eyebrow">Catálogo de extras</div><h1 class="h2 fw-bold mt-2 mb-1"><%= category_label || "A&B e equipamentos" %></h1><p class="text-secondary mb-0">Organize coffee breaks, buffets, itens avulsos e equipamentos para usar nos eventos.</p></div><%= link_to "+ Novo item", new_service_path(category: @category), class: "btn btn-primary" %></div>
  <nav class="nav nav-pills mb-4" aria-label="Categorias de serviços"><%= link_to "Todos", services_path, class: "nav-link #{@category.nil? ? 'active' : ''}" %><%= link_to "Alimentos e bebidas", services_path(category: "food_beverage"), class: "nav-link #{@category == 'food_beverage' ? 'active' : ''}" %><%= link_to "Equipamentos", services_path(category: "equipment"), class: "nav-link #{@category == 'equipment' ? 'active' : ''}" %></nav>
  <% if @services.any? %><div class="row g-3"><% @services.each do |service| %><div class="col-md-6 col-xl-4"><article class="card content-card h-100"><div class="card-body d-flex flex-column"><span class="badge text-bg-light border align-self-start"><%= Service::TYPE_LABELS[service.service_type] %></span><h2 class="h5 fw-bold mt-3"><%= link_to service.name, service, class: "link-dark text-decoration-none" %></h2><div class="h4 fw-bold text-primary mt-auto mb-3"><%= number_to_currency(service.price, unit: "R$ ", separator: ",", delimiter: ".") %></div><div class="d-flex gap-2 border-top pt-3"><%= link_to "Detalhes", service, class: "btn btn-outline-primary btn-sm flex-grow-1" %><%= link_to "Editar", edit_service_path(service), class: "btn btn-outline-secondary btn-sm" %><%= button_to "Excluir", service, method: :delete, data: { turbo_confirm: "Excluir #{service.name}?" }, class: "btn btn-outline-danger btn-sm" %></div></div></article></div><% end %></div>
  <% else %><section class="card empty-state text-center"><div class="card-body py-5"><h2 class="h5 fw-bold">Nenhum item cadastrado</h2><p class="text-secondary">Cadastre A&B ou equipamentos para adicionar à programação dos eventos.</p><%= link_to "Cadastrar item", new_service_path(category: @category), class: "btn btn-primary mt-2" %></div></section><% end %>
</main>
