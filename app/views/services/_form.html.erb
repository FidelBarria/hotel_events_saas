<%= form_with(model: service) do |form| %>
  <% if service.errors.any? %><div class="alert alert-danger"><h2 class="h6"><%= pluralize(service.errors.count, "erro") %> impediram salvar este item:</h2><ul class="mb-0"><% service.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>
  <div class="mb-3"><%= form.label :name, "Nome do item", class: "form-label" %><%= form.text_field :name, autofocus: true, required: true, class: "form-control", placeholder: "Ex.: Coffee break para 50 pessoas" %></div>
  <div class="mb-3"><%= form.label :service_type, "Tipo de item", class: "form-label" %><%= form.select :service_type, Service::TYPE_LABELS.map { |value, label| [label, value] }, {}, class: "form-select" %><div class="form-text">Use A&B avulso para itens como térmica de café, água e garrafas.</div></div>
  <div class="mb-4"><%= form.label :price, "Preço unitário (R$)", class: "form-label" %><%= form.number_field :price, min: 0, step: 0.01, required: true, class: "form-control", placeholder: "0,00" %></div>
  <div class="d-flex flex-column-reverse flex-sm-row justify-content-end gap-2 border-top pt-3"><%= link_to "Cancelar", services_path(category: service.category), class: "btn btn-outline-secondary" %><%= form.submit(service.persisted? ? "Salvar alterações" : "Criar item", class: "btn btn-primary") %></div>
<% end %>
