<% content_for :title, "Painel" %>
<main class="page-container">
  <section class="card hero-panel mb-4">
    <div class="card-body p-4 p-lg-5 position-relative">
      <div class="page-eyebrow text-white-50">Painel de controle</div>
      <div class="row align-items-end g-4 mt-1">
        <div class="col-lg"><h1 class="display-6 fw-bold mb-2">Olá, <%= current_user.name.presence || "usuário" %></h1><p class="text-white-50 mb-0">Acompanhe a ocupação dos espaços e a programação de eventos.</p></div>
        <div class="col-lg-auto d-flex gap-2"><%= link_to "Ver espaços", rooms_path, class: "btn btn-light" %><%= link_to "Novo evento", new_event_path, class: "btn btn-outline-light" %></div>
      </div>
    </div>
  </section>

  <section class="row g-3 mb-4" aria-label="Resumo da operação">
    <div class="col-md-4"><article class="card stat-card h-100"><div class="card-body p-4"><div class="text-secondary small">Total de salas</div><div class="stat-value mt-2"><%= @total_rooms %></div><div class="small text-secondary mt-3"><%= link_to "Gerenciar salas", rooms_path, class: "link-primary text-decoration-none" %></div></div></article></div>
    <div class="col-md-4"><article class="card stat-card h-100"><div class="card-body p-4"><div class="text-secondary small">Eventos hoje</div><div class="stat-value mt-2"><%= @events_today %></div><div class="small text-secondary mt-3">Eventos com reserva confirmada</div></div></article></div>
    <div class="col-md-4"><article class="card stat-card h-100"><div class="card-body p-4"><div class="text-secondary small">Eventos pendentes</div><div class="stat-value mt-2"><%= @pending_events %></div><div class="small text-secondary mt-3">Aguardando confirmação</div></div></article></div>
  </section>

  <% if current_user.admin? || current_user.staff? %>
    <section class="card content-card mb-4" aria-labelledby="follow-ups-title">
      <div class="card-header bg-white p-3 p-lg-4"><div class="page-eyebrow">Relacionamento com clientes</div><h2 class="h5 fw-bold mt-1 mb-0" id="follow-ups-title">Follow-ups para hoje</h2></div>
      <div class="card-body p-3 p-lg-4">
        <% if @follow_up_events.any? %>
          <div class="d-flex flex-column gap-3">
            <% @follow_up_events.each do |event| %>
              <article class="border rounded-3 p-3">
                <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">
                  <div>
                    <h3 class="h6 fw-bold mb-1"><%= link_to event.title, event_path(event), class: "link-primary" %></h3>
                    <div class="small text-secondary"><%= event.client&.name || event.requester_name %> · Contato agendado para <%= event.follow_up_on.strftime("%d/%m/%Y") %><%= " (atrasado)" if event.follow_up_on < Date.current %></div>
                    <% if event.follow_up_logs.any? %>
                      <div class="small mt-2"><strong>Última observação:</strong> <%= event.follow_up_logs.max_by(&:completed_on).observation %></div>
                    <% end %>
                  </div>
                  <%= link_to "Acessar evento", event_path(event), class: "btn btn-outline-primary btn-sm align-self-start" %>
                </div>
                <%= form_with url: complete_follow_up_event_path(event), scope: :follow_up, method: :patch, local: true, class: "row g-2 align-items-end mt-2" do |form| %>
                  <div class="col-lg"><%= form.label :observation, "Resposta do cliente ou ação realizada", class: "form-label small" %><%= form.text_area :observation, rows: 2, required: true, class: "form-control", placeholder: "Registre o resultado deste contato" %></div>
                  <div class="col-sm-6 col-lg-3"><%= form.label :next_follow_up_on, "Próximo follow-up", class: "form-label small" %><%= form.date_field :next_follow_up_on, min: (Date.current + 1.day).iso8601, required: true, class: "form-control" %></div>
                  <div class="col-sm-6 col-lg-auto"><%= form.submit "Registrar e agendar", class: "btn btn-primary w-100" %></div>
                <% end %>
              </article>
            <% end %>
          </div>
        <% else %>
          <p class="text-secondary mb-0">Não há follow-ups agendados para hoje.</p>
        <% end %>
      </div>
    </section>
  <% end %>

  <section class="card content-card">
    <div class="card-header bg-white d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 p-3 p-lg-4">
      <div><div class="page-eyebrow">Agenda das salas</div><h2 class="h5 fw-bold mt-1 mb-0">Semana de <%= @week_start.strftime("%d/%m") %> a <%= @week_end.strftime("%d/%m/%Y") %></h2></div>
      <nav class="btn-group" aria-label="Navegar entre semanas"><%= link_to "← Semana anterior", root_path(week: (@week_start - 7.days).iso8601, statuses: @selected_statuses, goal_month: @goal_month.strftime("%Y-%m"), chart_year: @chart_year), class: "btn btn-outline-secondary btn-sm" %><%= link_to "Esta semana", root_path(week: Date.current.beginning_of_week(:monday).iso8601, statuses: @selected_statuses, goal_month: @goal_month.strftime("%Y-%m"), chart_year: @chart_year), class: "btn btn-outline-primary btn-sm" %><%= link_to "Próxima semana →", root_path(week: (@week_start + 7.days).iso8601, statuses: @selected_statuses, goal_month: @goal_month.strftime("%Y-%m"), chart_year: @chart_year), class: "btn btn-outline-secondary btn-sm" %></nav>
    </div>
    <div class="card-body border-bottom py-3">
      <%= form_with url: root_path, method: :get, local: true, class: "d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3" do %>
        <%= hidden_field_tag :week, @week_start.iso8601 %><%= hidden_field_tag :goal_month, @goal_month.strftime("%Y-%m") %><%= hidden_field_tag :chart_year, @chart_year %>
        <fieldset class="d-flex flex-wrap align-items-center gap-3 border-0 p-0 m-0">
          <legend class="float-none w-auto fs-6 fw-semibold mb-0 me-1">Filtrar status:</legend>
          <%= hidden_field_tag "statuses[]", "" %>
          <% Booking::STATUSES.each do |status| %>
            <div class="form-check mb-0">
              <%= check_box_tag "statuses[]", status, @selected_statuses.include?(status), id: "calendar_status_#{status}", class: "form-check-input" %>
              <%= label_tag "calendar_status_#{status}", Booking::STATUS_LABELS.fetch(status), class: "form-check-label" %>
            </div>
          <% end %>
        </fieldset>
        <%= submit_tag "Aplicar filtros", class: "btn btn-outline-primary btn-sm align-self-start align-self-lg-center" %>
      <% end %>
    </div>
    <div class="calendar-scroll">
      <table class="table table-bordered calendar-table mb-0">
        <thead><tr><th scope="col" class="calendar-room-col">Sala</th><% @calendar_days.each do |day| %><th scope="col"><span class="d-block text-secondary small"><%= ["", "Seg", "Ter", "Qua", "Qui", "Sex", "Sáb", "Dom"][day.cwday] %></span><span><%= day.strftime("%d/%m") %></span></th><% end %></tr></thead>
        <tbody>
          <% if @rooms.any? %>
            <% @rooms.each do |room| %>
              <tr><th scope="row" class="calendar-room-col"><span class="fw-semibold"><%= room.name %></span><span class="d-block small text-secondary">Geral: <%= room.capacity %> pessoas</span><div class="row g-1 mt-1 calendar-room-capacities"><% Event::SETUP_FORMATS.each do |format, label| %><% capacity = room.capacity_for(format) %><div class="col-6"><span class="d-block text-truncate" title="<%= label %>: <%= capacity.presence || 'Nao informado' %> pessoas" aria-label="<%= label %>: <%= capacity.presence || 'Nao informado' %> pessoas"><%= { 'auditorium' => 'Aud.', 'u_shape' => 'Formato U', 'classroom' => 'Escolar', 'round_tables' => 'Mesas' }.fetch(format) %>: <strong><%= capacity.present? && capacity.positive? ? capacity : '—' %></strong></span></div><% end %></div></th>
                <% @calendar_days.each do |day| %>
                  <td><% bookings = @bookings_by_room_and_day[[room.id, day]] %><% if bookings.any? %><div class="d-flex flex-column gap-1"><% bookings.each do |booking| %><div class="calendar-event calendar-event--<%= booking.status %>" title="<%= booking.event.title %> · <%= booking.status_label %>"><%= link_to booking.event.title, event_path(booking.event), class: "link-dark text-decoration-underline", aria: { label: "Ver detalhes do evento #{booking.event.title}" } %><span class="d-block fw-normal"><%= booking.status_label %></span><%= link_to "Editar", edit_event_path(booking.event), class: "d-inline-block mt-1 small fw-semibold", aria: { label: "Editar evento #{booking.event.title}" } %></div><% end %></div><% else %><span class="text-body-tertiary">—</span><% end %></td>
                <% end %>
              </tr>
            <% end %>
          <% else %>
            <tr><td colspan="8" class="py-5 text-center text-secondary">Cadastre uma sala para visualizar a agenda.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="card-footer bg-white small text-secondary">A agenda exibe os eventos dos status selecionados. Um evento que ocupa mais de um dia aparece em cada dia da reserva.</div>
  </section>

  <%= render "annual_revenue_chart" %>
  <%= render "confirmed_monthly_chart" %>

  <% if @can_view_goals %>
  <section class="card content-card mt-4" aria-labelledby="monthly-goals-title">
    <div class="card-header bg-white d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 p-3 p-lg-4">
      <div><div class="page-eyebrow">Acompanhamento financeiro</div><h2 class="h5 fw-bold mt-1 mb-0" id="monthly-goals-title">Metas do mês <%= @goal_month.strftime("%m/%Y") %></h2></div>
      <%= link_to "Gerenciar metas do ano", monthly_goals_path(year: @goal_month.year), class: "btn btn-outline-primary" %>
    </div>
    <div class="card-body p-3 p-lg-4">
      <p class="small text-secondary mb-3">Atingido considera somente reservas com status confirmado no mês selecionado.</p>
      <div class="row g-3">
        <% [["Salas", :rooms, :rooms_target], ["Equipamentos", :equipment, :equipment_target], ["A&B", :food_beverage, :food_beverage_target], ["Total", :total, :total_target]].each do |label, actual_key, target_key| %>
          <% actual = @monthly_actuals[actual_key] %>
          <% target = @monthly_goal.public_send(target_key) || 0 %>
          <% progress = target.positive? ? (actual / target * 100).round(1) : 0 %>
          <div class="col-md-6 col-xl-3">
            <article class="goal-card h-100">
              <div class="d-flex justify-content-between align-items-center gap-2"><h3 class="h6 fw-bold mb-0"><%= label %></h3><span class="small fw-semibold text-primary"><%= number_to_percentage(progress, precision: 1, strip_insignificant_zeros: true) %></span></div>
              <div class="goal-progress mt-3" role="progressbar" aria-label="Meta de <%= label %>" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= [progress, 100].min %>"><div class="goal-progress-bar" style="width: <%= [[progress, 100].min, 0].max %>%"></div></div>
              <div class="d-flex justify-content-between gap-2 mt-2 small"><span class="text-secondary">Atingido</span><strong><%= number_to_currency(actual, unit: "R$ ", separator: ",", delimiter: ".") %></strong></div>
              <div class="d-flex justify-content-between gap-2 small"><span class="text-secondary">Meta</span><strong><%= number_to_currency(target, unit: "R$ ", separator: ",", delimiter: ".") %></strong></div>
            </article>
          </div>
        <% end %>
      </div>

    </div>
  </section>
  <% end %>
</main>
