<% month_names = %w[Janeiro Fevereiro Março Abril Maio Junho Julho Agosto Setembro Outubro Novembro Dezembro] %>
<% chart_left = 105 %>
<% chart_top = 28 %>
<% plot_height = 320 %>
<% plot_width = 920 %>
<% chart_bottom = chart_top + plot_height %>
<% slot_width = plot_width.to_f / 12 %>
<% confirmed_values = @annual_revenue.map { |month| month[:statuses]["confirmado"][:total].to_f } %>
<% maximum = confirmed_values.max || 0 %>
<% axis_step = [ (maximum / 4.0).ceil, 1 ].max %>
<% axis_maximum = axis_step * 4 %>
<% points = confirmed_values.each_with_index.map { |value, index| "#{chart_left + (slot_width * index) + slot_width / 2},#{chart_bottom - (value / axis_maximum * plot_height)}" }.join(" ") %>

<section class="card content-card mt-4" aria-labelledby="confirmed-monthly-title">
  <div class="card-header bg-white p-3 p-lg-4">
    <div class="page-eyebrow">Desempenho mensal</div>
    <h2 class="h5 fw-bold mt-1 mb-0" id="confirmed-monthly-title">Total de eventos confirmados · <%= @chart_year %></h2>
  </div>
  <div class="card-body p-3 p-lg-4">
    <p class="small text-secondary">Receita total confirmada por mês. Passe o mouse sobre um ponto para consultar o valor exato.</p>
    <div class="annual-chart-scroll">
      <svg class="annual-revenue-chart" viewBox="0 0 1060 405" role="img" aria-labelledby="confirmed-chart-svg-title confirmed-chart-svg-desc">
        <title id="confirmed-chart-svg-title">Total mensal de eventos confirmados em <%= @chart_year %></title>
        <desc id="confirmed-chart-svg-desc">Gráfico de linha com o valor total confirmado para cada mês do ano.</desc>
        <% (0..4).each do |tick| %>
          <% value = axis_step * tick %>
          <% y = chart_bottom - (plot_height * tick / 4.0) %>
          <line x1="<%= chart_left %>" y1="<%= y %>" x2="<%= chart_left + plot_width %>" y2="<%= y %>" class="annual-chart-gridline" />
          <text x="<%= chart_left - 12 %>" y="<%= y + 4 %>" text-anchor="end" class="annual-chart-axis-label"><%= number_to_currency(value, unit: "R$ ", separator: ",", delimiter: ".", precision: 0) %></text>
        <% end %>
        <line x1="<%= chart_left %>" y1="<%= chart_top %>" x2="<%= chart_left %>" y2="<%= chart_bottom %>" class="annual-chart-axis" />
        <line x1="<%= chart_left %>" y1="<%= chart_bottom %>" x2="<%= chart_left + plot_width %>" y2="<%= chart_bottom %>" class="annual-chart-axis" />
        <polyline points="<%= points %>" class="confirmed-chart-line" />
        <% confirmed_values.each_with_index do |value, index| %>
          <% x = chart_left + (slot_width * index) + slot_width / 2 %>
          <% y = chart_bottom - (value / axis_maximum * plot_height) %>
          <% month_name = month_names[@annual_revenue[index][:month].month - 1] %>
          <circle cx="<%= x %>" cy="<%= y %>" r="5" class="confirmed-chart-point">
            <title><%= month_name %> · Confirmado: <%= number_to_currency(value, unit: "R$ ", separator: ",", delimiter: ".") %></title>
          </circle>
          <text x="<%= x %>" y="<%= chart_bottom + 25 %>" text-anchor="middle" class="annual-chart-month-label"><%= month_name[0, 3] %></text>
        <% end %>
      </svg>
    </div>
  </div>
</section>
