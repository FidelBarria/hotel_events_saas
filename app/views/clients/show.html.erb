<% content_for :title, @client.name %>
<main class="page-container" style="max-width: 900px"><nav aria-label="breadcrumb" class="mb-3"><ol class="breadcrumb"><li class="breadcrumb-item"><%= link_to "Clientes", clients_path %></li><li class="breadcrumb-item active" aria-current="page"><%= @client.name %></li></ol></nav><section class="card hero-panel"><div class="card-body p-4 p-lg-5"><span class="badge text-bg-light text-primary">Cliente</span><h1 class="display-6 fw-bold mt-3"><%= @client.name %></h1><p class="text-white-50 mb-0"><%= @client.formatted_cnpj.presence || "CNPJ não informado" %></p></div></section><section class="card content-card mt-4"><div class="card-body p-4"><h2 class="h5 fw-bold mb-3">Dados de contato</h2><div class="row g-3"><div class="col-md-6"><div class="small text-secondary">E-mail</div><div class="fw-semibold"><%= @client.email.present? ? mail_to(@client.email) : "Não informado" %></div></div><div class="col-md-6"><div class="small text-secondary">Telefone</div><div class="fw-semibold"><%= @client.phone.presence || "Não informado" %></div></div><div class="col-md-6"><div class="small text-secondary">Eventos vinculados</div><div class="fw-semibold"><%= @client.events.count %></div></div></div></div></section><div class="d-flex flex-wrap gap-2 mt-4"><%= link_to "Editar cliente", edit_client_path(@client), class: "btn btn-primary" %><%= link_to "Voltar para clientes", clients_path, class: "btn btn-outline-secondary" %><%= button_to "Excluir cliente", @client, method: :delete, data: { turbo_confirm: "Excluir este cliente?" }, class: "btn btn-outline-danger" %></div></main>
